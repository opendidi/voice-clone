# 复制为 .env 后按需修改；已存在的系统环境变量优先

# ── 推理后端 ──────────────────────────────────────────────
# http = 常驻 bridge；auto/onnx/cli = 本机直跑；mock = 链路联调
MOSS_TTS_BACKEND=http
MOSS_TTS_SERVICE_URL=http://127.0.0.1:18090
MOSS_TTS_TIMEOUT=600
MOSS_TTS_CPU_THREADS=4
# 可选：覆盖默认路径（留空即用项目内的 third_party/.venv-moss）
# MOSS_TTS_REPO=
# MOSS_TTS_MODEL_DIR=
# MOSS_TTS_PYTHON=
MOSS_BRIDGE_TOKEN=
MOSS_BRIDGE_QUEUE_WAIT=120

# ── 主服务 ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5002
WEB_CONCURRENCY=8
VOICE_CLONE_LOG_LEVEL=INFO

# ── 鉴权与跨域 ────────────────────────────────────────────
# 两者都留空 = 单机免登录（档案归 local）
# 单 key 模式：填 VOICE_CLONE_API_KEY；前端 localStorage 写入 auth-token
VOICE_CLONE_API_KEY=
# 多用户隔离：JSON 对象，key -> uid
# VOICE_CLONE_USERS={"key-alice":"alice","key-bob":"bob"}
VOICE_CLONE_USERS=
VOICE_CLONE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 并发 / 任务 / 数据 ────────────────────────────────────
VOICE_CLONE_MAX_INFERENCE=2
VOICE_CLONE_SLOT_WAIT=30
VOICE_CLONE_SLOT_LEASE=900
VOICE_CLONE_JOB_TTL=3600
VOICE_CLONE_JOB_MAX=200
VOICE_CLONE_RETENTION=3600
VOICE_CLONE_MAX_FILES=200
VOICE_CLONE_PROBE_CACHE=8
VOICE_CLONE_LONG_TTS_MAX_CHARS=5000
# 数据目录留空 = <项目根>/var（声纹与产物，绝不作为静态资源托管）
# VOICE_CLONE_DATA_DIR=
# 允许前端指定 onnx/cli/http 后端（默认禁止；mock 演示模式始终允许）
VOICE_CLONE_ALLOW_BACKEND_OVERRIDE=0
